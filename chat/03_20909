import pandas as pd
import numpy as np
from scipy import stats

pa = pd.read_csv('신체활동_영역_지표_결과_20261116125020.csv', encoding='utf-8')
bf = pd.read_csv('주5일_이상_아침식사_결식률_20261116125001.csv', encoding='cp949')

print("BF unique 성별(1):", bf['성별(1)'].unique())
print("BF rows with 응답자특성별(2) == '소계':")
