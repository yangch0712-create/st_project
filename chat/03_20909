years = ['2019', '2020', '2021', '2022', '2023', '2024', '2025']
# Extract PA percentages
# Row 2: 하루 60분 주5일 이상 신체활동 실천율
# Row 3: 주3일 이상 고강도 신체활동 실천율
# Row 4: 주3일 이상 근력강화운동 실천율
# Columns for 전체 백분율: 2019.1, 2020.1, ...
# Columns for 남학생 백분율: 2019.3, ...
# Columns for 여학생 백분율: 2019.5, ...

bf_sub = bf[bf['응답자특성별(2)'] == '소계'].set_index('성별(1)')
for gender, pa_offset in [('전체', '.1'), ('남학생', '.3'), ('여학생', '.5')]:
    bf_vals = [float(bf_sub.loc[gender, y + '.1']) for y in years]
    print(f"\n--- {gender} ---")
    print("결식률:", bf_vals)
    for idx in [2, 3, 4]:
        name = pa.loc[idx, '신체활동지표별(1)']
        pa_vals = [float(pa.loc[idx, y + pa_offset]) for y in years]
        r, p = stats.pearsonr(bf_vals, pa_vals)
        print(f"{name}: {pa_vals} -> r={r:.4f}, p={p:.4f}")


